{
  "expo": {
    "name": "ShopNekt",
    "slug": "shopnekt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shopnekt",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qnex360.shopnekt",
      "infoPlist": {
        "NSCameraUsageDescription": "ShopNekt uses camera for product photos",
        "NSLocationWhenInUseUsageDescription": "ShopNekt uses location for delivery",
        "NSMicrophoneUsageDescription": "ShopNekt uses microphone for voice messages"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.qnex360.shopnekt",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}