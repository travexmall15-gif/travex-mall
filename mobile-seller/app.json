{
  "expo": {
    "name": "ShopNekt Seller",
    "slug": "shopnekt-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shopnektseller",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080F37"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qnex360.shopnektseller",
      "infoPlist": {
        "NSCameraUsageDescription": "ShopNekt Seller uses camera for product photos",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080F37"
      },
      "package": "com.qnex360.shopnektseller",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-splash-screen"
    ],
    "extra": {}
  }
}