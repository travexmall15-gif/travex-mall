{
  "headers": {
    "x-nextjs-stale-time": "180",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/open-store/layout,_N_T_/open-store/page,_N_T_/open-store"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/open-store/__PAGE__",
    "/open-store",
    "/_index",
    "/_head"
  ]
}