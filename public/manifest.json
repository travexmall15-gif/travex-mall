{
  "name": "ShopNekt",
  "short_name": "ShopNekt",
  "description": "Buy and sell online with verified sellers. Business Market, Flash Deals, Group Buy, Social Vybe and more.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#ffffff",
  "theme_color": "#0D1B3E",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "categories": ["shopping", "business", "finance"],
  "icons": [
    { "src": "/favicon.ico",          "sizes": "48x48",   "type": "image/x-icon" },
    { "src": "/icon-192.png",         "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png","sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512.png",         "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png","sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "screenshots": [
    {
      "src": "/splash.png",
      "type": "image/png",
      "sizes": "1170x2532",
      "form_factor": "narrow",
      "label": "ShopNekt Home Screen"
    }
  ],
  "shortcuts": [
    { "name": "Business Market", "short_name": "Market",     "url": "/market",      "description": "Browse verified business stores",   "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Flash Deals",     "short_name": "Deals",      "url": "/flash-deals", "description": "Best limited-time deals",          "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Group Buying",    "short_name": "Group Buy",  "url": "/group-buy",   "description": "Save more by buying together",     "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Social Vybe",     "short_name": "Vybe",       "url": "/vybe",        "description": "Discover via photos and videos",   "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/vybe",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
